#!/bin/sh
# Blocks commits that change mkdocs.yml's `nav:` without regenerating the
# llmstxt plugin's `sections:` block to match (see scripts/gen_llms_sections.py).
# Enable once per clone with: git config core.hooksPath .githooks

if ! git diff --cached --name-only | grep -q '^mkdocs\.yml$'; then
    exit 0
fi

PYTHON=python3
if [ -x "venv/bin/python3" ]; then
    PYTHON=venv/bin/python3
fi

"$PYTHON" scripts/gen_llms_sections.py --check
status=$?

if [ "$status" -ne 0 ]; then
    echo ""
    echo "Run 'python3 scripts/gen_llms_sections.py' and paste the 'sections:'"
    echo "block into mkdocs.yml under 'plugins: - llmstxt:', then re-stage."
    echo "(bypass with 'git commit --no-verify' if this is a deliberate exception)"
fi

exit $status
